<%- layout('/layout/master.ejs') %>
<head>
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css"
    integrity="sha512-QeR2VH+lsBE5LSAe1Q5EnTBbe7XTBubt8dG93Y7gidSgdMCr8nVqKcfKAMyN96SV8KDbZVTDXChatu5G2KQGzg=="
    crossorigin="anonymous"
    referrerpolicy="no-referrer"
  />
</head>
<body>
  <main>
    <div class="log-info">
      <img
        src="/Assets/instagram-logo.png"
        alt="instagram-logo"
        class="login-insta-logo mt-5 ms-5 mb-3"
      />
      <p class="text-center log-art-text">
        See everyday moments from your <br /><span class="login-grad-text">close friends.</span>
      </p>
      <img
        src="/Assets/login-left-art.webp"
        alt="login-insta-art"
        class="login-insta-art mx-auto d-block"
      />
    </div>
    <div class="log-forms">
      <div class="form-1">
        <img class="form-insta-logo" src="/Assets/instagram-logo.png" alt="" />
      </div>
      <div class="row form-1">
        <form method="POST" action="/user" class="needs-validation" novalidate>
          <p class="h5 mb-4">Log in to Instagram</p>
          <div>
            <input
              type="email"
              placeholder="Email address"
              class="form-control form-control-lg mb-3"
              name="email"
              required
            />
          </div>
          <div class="invalid-feedback">Please enter correct email address</div>
          <div>
            <input
              type="password"
              class="form-control form-control-lg mb-5"
              name="password"
              placeholder="Password"
              required
            />
          </div>
          <div class="invalid-feedback">Please enter password</div>
          <button class="btn btn-login btn-dark rounded-xl mb-3">Log in</button>
          <br />
          <button class="btn forget-btn btn-dark">Forgotten password?</button>
        </form>
      </div>
      <div class="row form-2">
        <a href="/new" class="btn new-account-btn">Create new account</a>
        <p class="text-center meta-logo"><i class="bi bi-meta"></i> &nbsp;Meta</p>
      </div>
    </div>
  </main>
  <%- include('../views/includes/footer.ejs') %>
</body>
