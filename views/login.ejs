<%- layout('layout/master.ejs') %>

<div class="login-page-wrapper">
  <div class="login-main-container">
    <!-- Left Hero Art Section -->
    <div class="login-art-section">
      <img src="/Assets/instagram-logo.png" alt="Instagram" class="login-brand-logo" />
      <h1 class="login-hero-text">
        See everyday moments from your <br />
        <span class="login-grad-text">close friends.</span>
      </h1>
      <img src="/Assets/login-left-art.webp" alt="Instagram Art" class="login-hero-img" />
    </div>

    <!-- Right Login Forms Section -->
    <div class="login-form-section">
      <!-- Main Login Card -->
      <div class="login-card">
        <h2 class="login-card-title">Log in to InFrame</h2>
        <form method="POST" action="/user" class="needs-validation" novalidate>
          <div class="mb-3 text-start">
            <input
              type="email"
              placeholder="Email address"
              class="ig-input"
              name="email"
              required
            />
            <div class="invalid-feedback text-start mt-1">Please enter a valid email address.</div>
          </div>

          <div class="mb-3 text-start">
            <input
              type="password"
              class="ig-input"
              name="password"
              placeholder="Password"
              required
            />
            <div class="invalid-feedback text-start mt-1">Please enter your password.</div>
          </div>

          <button type="submit" class="btn-ig-primary w-100 mt-2">Log in</button>

          <div class="ig-divider">OR</div>

          <a href="#" class="login-forgot-link">Forgotten your password?</a>
        </form>
      </div>

      <!-- Sign Up Switch Card -->
      <div class="login-signup-card">
        <span>Don't have an account?</span>
        <a href="/new">Sign up</a>
      </div>

      <!-- Meta Branding -->
      <div class="meta-brand-tag">
        <i class="bi bi-meta"></i>
        <span>Meta</span>
      </div>
    </div>
  </div>

  <%- include('includes/footer.ejs') %>
</div>

