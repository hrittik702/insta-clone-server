<%- layout('/layout/master.ejs') %>
<body>
  <%- include('includes/sidebar.ejs') %>
  <div class="profile-container">
    <div class="profile">
      <div class="p-head">
        <div class="p-head-up">
          <% if(profile.photo) {%>
            <img src="<%=profile.photo%>" alt="profile-photo" />
            <% } else {%>
            <img src="/Assets/user.png" alt="hello1">
            <% }%>
          <div class="profile-info">
            <p class="h3">
              <b><%=profile.username%></b> <a href=""><i class="bi bi-gear-wide"></i></a>
            </p>
            <p><%= profile.name %></p>
            <p class="small">
              <a href="/<%=profile.username%>/posts"><%=profile.posts%> posts</a>  &nbsp;&nbsp;
              <a href="/<%=profile.username%>/followers"><%=profile.followers%> followers</a> &nbsp;&nbsp;
              <a href="/<%=profile.username%>/followings"><%=profile.followings%> following</a>
            </p>
            <p class="small"><%= profile.bio %></p>
          </div>
        </div>
        <div class="profile-settings">
          <button class="btn btn-dark">Edit Profile</button>
          <button class="btn btn-dark">View archive</button>
        </div>
        <div class="highlights">
          <div class="highlight"><i class="bi bi-plus-circle-fill"></i></div>
        </div>
      </div>
    </div>
    <%- include('./includes/footer.ejs') %>
  </div>
</body>
