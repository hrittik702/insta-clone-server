<%- layout('layout/master.ejs') %>

<div class="signup-page-wrapper">
  <div class="signup-card-container">
    <!-- Main Signup Card -->
    <div class="signup-card">
      <a href="/" class="back-btn" title="Back to Login"><i class="bi bi-arrow-left"></i></a>
      <img src="/Assets/instagram-logo.png" alt="Instagram" class="login-brand-logo mx-auto" />
      <p class="signup-subtitle">Sign up to see photos and videos from your friends.</p>

      <form method="POST" action="/new" class="needs-validation text-start" novalidate>
        <div class="mb-2">
          <input
            type="email"
            class="ig-input"
            placeholder="Email address"
            id="email"
            name="email"
            required
          />
          <div class="invalid-feedback">Please enter your email address.</div>
        </div>

        <div class="mb-2">
          <input
            type="password"
            class="ig-input"
            placeholder="Password"
            id="password"
            name="password"
            required
          />
          <div class="invalid-feedback">Please enter a password.</div>
        </div>

        <div class="mb-2">
          <input
            type="text"
            class="ig-input"
            placeholder="Full Name"
            id="name"
            name="name"
            required
          />
          <div class="invalid-feedback">Please enter your full name.</div>
        </div>

        <div class="mb-3">
          <input
            type="text"
            class="ig-input"
            placeholder="Username"
            id="username"
            name="username"
            required
          />
          <div class="invalid-feedback">Please choose a username.</div>
        </div>

        <div class="mb-3">
          <span class="dob-label">Date of Birth</span>
          <div class="row g-2">
            <div class="col-4">
              <input type="number" class="ig-input" placeholder="DD" min="1" max="31" />
            </div>
            <div class="col-4">
              <input type="number" class="ig-input" placeholder="MM" min="1" max="12" />
            </div>
            <div class="col-4">
              <input type="number" class="ig-input" placeholder="YYYY" min="1900" max="2026" />
            </div>
          </div>
        </div>

        <p class="signup-terms">
          People who use our service may have uploaded your contact information to InFrame.
          <a href="#">Learn more.</a>
        </p>
        <p class="signup-terms">
          By signing up, you agree to our <a href="#">Terms</a>, <a href="#">Privacy Policy</a> and
          <a href="#">Cookies Policy</a>.
        </p>

        <button type="submit" class="btn-ig-primary w-100 mt-2">Sign Up</button>
      </form>
    </div>

    <!-- Login Switch Card -->
    <div class="login-signup-card">
      <span>Have an account?</span>
      <a href="/">Log in</a>
    </div>

    <!-- Meta Branding -->
    <div class="meta-brand-tag">
      <i class="bi bi-meta"></i>
      <span>Meta</span>
    </div>
  </div>

  <%- include('includes/footer.ejs') %>
</div>

