<%- layout('/layout/master.ejs') %>
<head>
  <link rel="stylesheet" href="/css/new-account.css" />
</head>
    <div class="new-account">
       <div class="forms">
         <form method="post" class="needs-validation" action="/new" novalidate>
             <a href="/"><i class="bi bi-arrow-left-short back-login"></i></a>
             <div class="form-down">
                <p class="meta-logo"><i class="bi bi-meta"></i> &nbsp;Meta</p>
                <p class="h3">Get started on Instagram</p>
                <p>Sign up to see photos and videos from your friends.</p>
                <div>
                    <label for="email" class="form-label">Email address</label>
                    <input type="text" class="form-control mb-2" placeholder="E-mail address" id="email" name="email" required>
                    <div class="invalid-feedback">Please enter your email address</div>
                </div>
                <p>You may receive notifications from us. <a href="">Learn why we ask for you contact information</a></p>
                <div class="mb-2">
                    <label for="password" class="form-label">Password</label>
                    <input type="password" class="form-control mb-3" placeholder="Password" id="password" name="password">
                    <div class="invalid-feedback">Please enter password</div>
                </div>
                <div>
                    <label for="dob" class="form-label" aria-disabled="true">Date of Birth</label>
                    <div class="row mb-3">
                        <div class="col-4">
                            <input type="number" class="form-control" placeholder="Date">
                        </div>
                        <div class="col-4">
                            <input type="number" class="form-control" placeholder="Month">
                        </div>
                        <div class="col-4">
                            <input type="number" class="form-control" placeholder="Year">
                        </div>
                    </div>
                </div>
                <div>
                    <label for="name" class="form-label">Name</label>
                    <input type="text" class="form-control mb-3" placeholder="Full Name" id="name" name="name">
                </div>
                <div>
                    <label for="username" class="form-label">Username</label>
                    <input type="text" class="form-control mb-3" placeholder="Username" id="username" name="username">
                </div>
                <p>People who use our service may have uploaded your contact information to Instagram. <a href="">Learn more.</a></p>
                <p>By tapping Submit, you agree to create an account and to Instagram's <a href="">Terms</a>, <a href="">Privacy Policy</a> and <a href="">Coolies Policy</a>.</p>
                <p>The <a href="">Privacy Policy</a> describes the ways we can use the information we collect when you create an account. For example, we use this information to provide, personalize and improve our products, including ads.</p>
                <button class="btn btn-dark submit-btn">Submit</button><br>
                <a href="/">I already have an account</a>
            </div>
        </form>
       </div>
    </div>
  <%- include('./includes/footer.ejs') %>
</body>
